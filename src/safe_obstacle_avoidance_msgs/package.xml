<?xml version="1.0"?>
<package format="3">
  <name>safe_obstacle_avoidance_msgs</name>
  <version>0.1.0</version>
  <description>ROS 2 messages for depth-image ellipsoid safe sets.</description>
  <maintainer email="maintainer@example.com">safe-obstacle-avoidance-ros2</maintainer>
  <license>NOASSERTION</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>
