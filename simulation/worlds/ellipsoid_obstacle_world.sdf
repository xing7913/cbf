<?xml version="1.0"?>
<sdf version="1.9">
  <world name="ellipsoid_obstacle_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6e-6 2.3e-5 -4.2e-5</magnetic_field>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <direction>-0.5 0.2 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 20</size></plane></geometry>
          <material><ambient>0.72 0.74 0.76 1</ambient><diffuse>0.72 0.74 0.76 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- A compact differential-drive research base. Its forward direction is +X (REP-103). -->
    <model name="safe_bot">
      <pose>0 0 0.12 0 0 0</pose>
      <link name="base_link">
        <inertial>
          <mass>5.0</mass>
          <inertia>
            <ixx>0.0368</ixx><iyy>0.0523</iyy><izz>0.0808</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="chassis_collision">
          <geometry><box><size>0.34 0.28 0.10</size></box></geometry>
        </collision>
        <visual name="chassis_visual">
          <geometry><box><size>0.34 0.28 0.10</size></box></geometry>
          <material><ambient>0.12 0.28 0.55 1</ambient><diffuse>0.12 0.28 0.55 1</diffuse></material>
        </visual>
        <!-- Camera optical axis points along the robot's +X forward direction. -->
        <sensor name="front_depth_camera" type="depth_camera">
          <pose>0.13 0 0.18 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <visualize>true</visualize>
          <topic>/camera/depth_image</topic>
          <camera>
            <horizontal_fov>2.09439510239</horizontal_fov>
            <image><width>320</width><height>240</height><format>R_FLOAT32</format></image>
            <clip><near>0.10</near><far>8.0</far></clip>
          </camera>
        </sensor>
      </link>

      <link name="left_wheel">
        <pose>0 0.16 -0.06 -1.57079632679 0 0</pose>
        <inertial>
          <mass>0.30</mass>
          <inertia><ixx>0.00030</ixx><iyy>0.00030</iyy><izz>0.00054</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision"><geometry><cylinder><radius>0.06</radius><length>0.035</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.06</radius><length>0.035</length></cylinder></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
      </link>
      <joint name="left_wheel_joint" type="revolute">
        <pose relative_to="base_link">0 0.16 -0.06 0 0 0</pose>
        <parent>base_link</parent><child>left_wheel</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>

      <link name="right_wheel">
        <pose>0 -0.16 -0.06 -1.57079632679 0 0</pose>
        <inertial>
          <mass>0.30</mass>
          <inertia><ixx>0.00030</ixx><iyy>0.00030</iyy><izz>0.00054</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision"><geometry><cylinder><radius>0.06</radius><length>0.035</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.06</radius><length>0.035</length></cylinder></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
      </link>
      <joint name="right_wheel_joint" type="revolute">
        <pose relative_to="base_link">0 -0.16 -0.06 0 0 0</pose>
        <parent>base_link</parent><child>right_wheel</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>

      <!-- Small passive support rollers keep the chassis level. -->
      <link name="rear_caster">
        <pose>-0.13 0 -0.085 0 0 0</pose>
        <inertial><mass>0.08</mass><inertia><ixx>0.00003</ixx><iyy>0.00003</iyy><izz>0.00003</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><sphere><radius>0.035</radius></sphere></geometry></collision>
        <visual name="visual"><geometry><sphere><radius>0.035</radius></sphere></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
      </link>
      <joint name="rear_caster_joint" type="fixed"><pose relative_to="base_link">-0.13 0 -0.085 0 0 0</pose><parent>base_link</parent><child>rear_caster</child></joint>

      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.32</wheel_separation>
        <wheel_radius>0.06</wheel_radius>
        <topic>/model/safe_bot/cmd_vel</topic>
        <odom_topic>/model/safe_bot/odometry</odom_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
        <odom_publish_frequency>30</odom_publish_frequency>
        <max_linear_velocity>0.26</max_linear_velocity>
        <min_linear_velocity>-0.26</min_linear_velocity>
        <max_angular_velocity>1.82</max_angular_velocity>
        <min_angular_velocity>-1.82</min_angular_velocity>
      </plugin>
    </model>

    <!-- Static obstacles deliberately placed in the robot's forward depth-camera FOV. -->
    <model name="obstacle_1"><static>true</static><pose>1.65 0.00 0.40 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><cylinder><radius>0.24</radius><length>0.80</length></cylinder></geometry></collision>
      <visual name="visual"><geometry><cylinder><radius>0.24</radius><length>0.80</length></cylinder></geometry><material><ambient>0.85 0.22 0.12 1</ambient><diffuse>0.85 0.22 0.12 1</diffuse></material></visual>
    </link></model>
    <model name="obstacle_2"><static>true</static><pose>3.10 0.68 0.40 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><cylinder><radius>0.28</radius><length>0.80</length></cylinder></geometry></collision>
      <visual name="visual"><geometry><cylinder><radius>0.28</radius><length>0.80</length></cylinder></geometry><material><ambient>0.85 0.55 0.10 1</ambient><diffuse>0.85 0.55 0.10 1</diffuse></material></visual>
    </link></model>
    <model name="obstacle_3"><static>true</static><pose>4.40 -0.55 0.35 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>0.55 0.55 0.70</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.55 0.55 0.70</size></box></geometry><material><ambient>0.15 0.58 0.35 1</ambient><diffuse>0.15 0.58 0.35 1</diffuse></material></visual>
    </link></model>
  </world>
</sdf>
